# Supabase → Project Settings → Database → Connection string
# Pooler (Transaction mode, port 6543) – dùng khi chạy trên Vercel
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Kết nối trực tiếp (port 5432) – dùng cho prisma db push / migrate
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Chuỗi ngẫu nhiên dài (ví dụ: openssl rand -base64 32)
PARTICIPANT_TOKEN_SECRET=""
CRON_SECRET=""

# Nhận diện đơn vị (không bắt buộc). Bỏ trống thì hiện tên ExamQR.
# NEXT_PUBLIC_ORG_NAME="Tên học viện / trường chính trị"
# NEXT_PUBLIC_ORG_UNIT="Khoa Lý luận chính trị"
# Đường dẫn logo: đặt file vào thư mục public/ (ví dụ public/logo.png → "/logo.png") hoặc dùng URL đầy đủ.
NEXT_PUBLIC_ORG_NAME=""
NEXT_PUBLIC_ORG_UNIT=""
NEXT_PUBLIC_ORG_LOGO=""
